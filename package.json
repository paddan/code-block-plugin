		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"highlight.js": "^11.12.0",
		"jiti": "^2.6.1",
		"obsidian": "1.13.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0"
	}
